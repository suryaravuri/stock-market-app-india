# India app. Copy to .env and fill in. NEVER commit .env.

APP_MARKET=IN

# --- database: separate from the US app ---
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=stockmarket_in
DATABASE_USER=stockuser
DATABASE_PASSWORD=

# --- secrets ---
JWT_SECRET_KEY=
BROKER_ENCRYPTION_KEY=
JOB_TRIGGER_TOKEN=

# --- Zerodha Kite Connect (needs an active subscription; daily login) ---
KITE_API_KEY=
KITE_API_SECRET=
ZERODHA_POST_LOGIN_REDIRECT_URL=http://localhost:5174/
# Orders: keep dry-run until you've registered your static IP with Zerodha
# (SEBI/NSE rule since 1 April 2026: API orders only from a whitelisted static IP).
ZERODHA_TRADING_ENABLED=false
ZERODHA_DRY_RUN=true
ZERODHA_ALLOWED_USER_EMAILS=
ZERODHA_MAX_ORDER_VALUE_INR=10000
ZERODHA_MAX_ORDERS_PER_DAY=10

# --- US / Alpaca features: not used by the India app ---
LIVE_TRADING_ENABLED=false
AUTO_TRADING_ENABLED=false
LIVE_BOUNCE_ENABLED=false
EARLY_ALERTS_ENABLED=false
HOLDINGS_GUARD_ENABLED=false
MARKET_FILTER_ENABLED=false

# --- scheduler: sync -> scan every 15 min in NSE hours (9:15-15:30 IST) ---
LOCAL_SCHEDULER_ENABLED=true
LOCAL_SCHEDULER_INTERVAL_MINUTES=15
